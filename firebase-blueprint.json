        "receiverCodeExpiresAt": { "type": "number" },
        "donorCode": { "type": "string" },
        "donorCodeCreatedAt": { "type": "number" },
        "donorCodeExpiresAt": { "type": "number" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "string" },
        "fileType": { "type": "string" },
        "fileDataUrl": { "type": "string" },
        "status": { "type": "string" },
        "unlockedAt": { "type": "number" },
        "unlockedExpiresAt": { "type": "number" },
        "createdAt": { "type": "number" }
