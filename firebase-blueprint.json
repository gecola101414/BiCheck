{
  "entities": {
    "SharedFolder": {
      "title": "Shared Folder",
      "description": "A temporary shared folder for real-time file exchange between two devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 4 },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "files": {
          "type": "array",
          "items": {
            "$ref": "SharedFile"
          }
        },
        "status": { "type": "string", "enum": ["active", "expired", "closed"] }
      },
      "required": ["id", "code", "createdAt", "expiresAt", "status"]
    },
    "SharedFile": {
      "title": "Shared File",
      "description": "Metadata for a file within a shared folder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "number" },
        "type": { "type": "string" },
        "uploadedAt": { "type": "number" },
        "donorId": { "type": "string" }
      },
      "required": ["id", "name", "size", "type", "uploadedAt"]
    }
  },
  "firestore": {
    "/folders/{folderId}": {
      "schema": "SharedFolder",
      "description": "Shared folder sessions."
    }
  }
}
