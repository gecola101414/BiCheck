rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() == 6 && id.matches('^[0-9]+$');
    }

    match /stanze_condivisione/{roomId} {
      allow get: if isValidId(roomId);
      allow create: if isValidId(roomId) 
        && request.resource.data.keys().hasAll(['status', 'createdAt'])
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time;
      
      allow update: if isValidId(roomId)
        && (
          // Action: Join
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) 
           && request.resource.data.status == 'joined')
          ||
          // Action: Ready
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
           && request.resource.data.status == 'ready')
        );
      
      allow delete: if isValidId(roomId);

      match /documenti/{docId} {
        allow read, write: if isValidId(roomId);
      }
    }
  }
}
